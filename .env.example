# 复制为 .env 后填写本机配置；.env 已被 Git 忽略，不要把真实密钥写入本模板。
# npm start 与 npm run model:save 自动读取 .env，显式进程环境变量优先。
ZHIBAN_PORT=3210
ZHIBAN_DATA_DIR=.data

# 文本模型的三项配置需同时填写；全部留空时保持未配置状态。
ZHIBAN_MODEL_BASE_URL=
ZHIBAN_MODEL_ID=
ZHIBAN_MODEL_API_KEY=
# 代码中已登记的官方 DeepSeek 模型可用 auto，其他服务须填写实际支持的正整数。
ZHIBAN_MODEL_CONTEXT_WINDOW=auto
ZHIBAN_MODEL_MAX_TOKENS=auto
ZHIBAN_MODEL_TIMEOUT_MS=120000
ZHIBAN_MODEL_IMAGE_INPUT=false

# 可选向量模型；三项全部留空时商家记忆检索仅使用本地 BM25，不发向量请求。
# 配置后在 BM25 上增加向量召回；兼容 POST {BASE_URL}/embeddings，通常 BASE_URL 以 /v1 结尾。
# 不从文本模型配置借用地址或密钥。使用远程服务会发送本轮可读记忆文字，并可能产生费用。
ZHIBAN_EMBEDDING_BASE_URL=
ZHIBAN_EMBEDDING_MODEL_ID=
ZHIBAN_EMBEDDING_API_KEY=
ZHIBAN_EMBEDDING_TIMEOUT_MS=10000
# 可选；仅服务支持自定义维度时填写，留空使用服务实际返回维度。
ZHIBAN_EMBEDDING_DIMENSIONS=

# 用于解锁或保存本机加密模型配置；只在本地 .env 中填写。
ZHIBAN_MASTER_KEY=

# 图片服务留空时不可用；也可使用进程环境中的 ARK_API_KEY。
ZHIBAN_SEEDREAM_API_KEY=
ZHIBAN_SEEDREAM_MODEL_ID=doubao-seedream-5-0-flash-260915
ZHIBAN_IMAGE_TIMEOUT_MS=180000
