{
  "name": "zhiban-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "npm run build:host && npm run build:web",
    "build:host": "tsc -p tsconfig.host.json",
    "build:web": "vite build",
    "start": "node scripts/start-host.mjs",
    "model:save": "npm run build:host && node dist/host/model/save-model.js",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check": "biome check src && npm run check:comments",
    "check:comments": "node scripts/check-source-comments.mjs"
  },
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@fastify/static": "10.1.3",
    "ajv": "8.20.0",
    "fastify": "5.11.2",
    "playwright-core": "^1.64.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "json-schema-to-ts": "3.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
